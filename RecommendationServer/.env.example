# 이 파일을 .env.local 로 복사해서 값을 채웁니다.
#   cp RecommendationServer/.env.example RecommendationServer/.env.local
#
# .env.local 은 커밋하지 않습니다. .gitignore 에 들어 있습니다.
#
# 값이 채워졌는지는 서버를 띄운 뒤 확인할 수 있습니다.
#   curl http://localhost:8787/health

# ── 장소 검색 (필수) ──────────────────────────────────────────────
# 앱의 모든 장소 검색(홈·지도·장소 제보)이 이 키로 동작합니다.
# 없으면 검색 결과가 비어 보입니다.
# 발급: https://developers.naver.com  검색 > 지역
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 장소 검증 (선택) ──────────────────────────────────────────────
# POST /verify-spots 에서만 씁니다. 없어도 장소 검색은 동작합니다.
# 발급: https://developers.kakao.com  REST API 키
KAKAO_REST_API_KEY=

# ── 제보 검토 관리자 토큰 (필수) ──────────────────────────────────
# 사용자 장소 제보를 승인·반려하는 관리자 API 를 여는 토큰입니다.
# 앱이나 클라이언트 코드에 절대 넣지 않습니다.
# 충분히 긴 무작위 문자열로 만드세요.
#   openssl rand -hex 32
VIEWFINDER_ADMIN_REVIEW_TOKEN=

# ── 서버 (선택) ───────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
